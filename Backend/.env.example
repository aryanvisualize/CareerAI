# Public CareerAI frontend URL used in report links and CORS configuration.
FRONTEND_URL=http://localhost:5173

# n8n report-ready Webhook production URL. Use /webhook-test/ only during local testing.
N8N_REPORT_READY_WEBHOOK_URL=

# Must match the Passphrase in the n8n Webhook node's JWT Auth credential (HS256).
N8N_REPORT_READY_JWT_SECRET=
